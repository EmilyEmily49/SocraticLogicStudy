// Cloudflare config: serve this folder as a static site (no build step needed).
{
  "name": "socraticlogicstudy",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application"
  },
  // Lets non-production branches deploy as Cloudflare Previews.
  "previews": {}
}
