rules_version = '2';
// Security rules for Socratic Logic Study.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMember() {
      return signedIn() && exists(/databases/$(db)/documents/members/$(request.auth.uid));
    }
    function validProfile() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.points is int && d.points >= 0
        && d.weekPoints is int && d.weekPoints >= 0 && d.weekPoints <= d.points
        && d.streak is int && d.streak >= 0 && d.streak <= 3650;
    }

    // Holds the invite code. Nobody can read or change it from the app.
    match /meta/{doc} { allow read, write: if false; }

    // Joining requires the correct invite code.
    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.code == get(/databases/$(db)/documents/meta/group).data.inviteCode;
      allow update, delete: if false;
    }

    // Public profiles: visible to group members; each person edits only their own.
    match /profiles/{uid} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid && validProfile()
        && request.resource.data.points <= 100;
      allow update: if isMember() && request.auth.uid == uid && validProfile()
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points - resource.data.points <= 5000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Private study progress: only the owner.
    match /progress/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
